Program _Ab3 ; 
Start Var Int_4 _Aa1 , _Bb2 , _Cc5 , _Ma0 ;
  GET ( _Aa1 )
  GET ( _Bb2 )
  GET ( _Cc4 )

  If _Aa1 Le _Bb2 And _Aa1 Le _Cc5 {
    _Ma0 :> _Aa1
  } -Else _Bb2 Le _Aa1 And _Bb2 Le _Cc5 {
    _Ma0 :> _Bb2
  } -Else {
    _Ma0 :> _Cc5
  }
  Print ( _Ma0 )

  If ( _Aa1 Eg _Bb2 ) And ( _Aa1 == _Cc5 ) And ( _Bb2 == _Cc5 ) {
    Print ( 1 )
  } -Else {
    Print ( 0 )
  }
    
  If Not ( _Aa1 Le 0 ) || Not ( _Bb2 Le 0 ) || Not ( _Cc5 Le 0 ) {
    Print ( -1 )
  } -Else {
    Print ( 0 )
  }

  If _Aa1 >= ( _Bb2 + _Cc5 ) {
    Print ( 10 )
  } -Else {
    Print ( 0 )
  }
 
End